# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Free key from https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=

# Optional: free-tier Gemini models to try, in order
GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Comma-separated Telegram user IDs allowed to use the bot (send /myid to the bot to find yours)
ALLOWED_USER_IDS=

# Optional: proxy for networks that block Telegram, e.g. socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# Daily briefing settings
TIMEZONE=Europe/London
DAILY_BRIEF_TIME=08:00
# Optional: chat IDs that should always get the daily briefing, even after a restart
DAILY_CHAT_IDS=
